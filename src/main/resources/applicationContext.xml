<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xmlns:context="http://www.springframework.org/schema/context"
       xsi:schemaLocation="http://www.springframework.org/schema/beans
           http://www.springframework.org/schema/beans/spring-beans.xsd
           http://www.springframework.org/schema/context
           http://www.springframework.org/schema/context/spring-context.xsd">

    <context:property-placeholder location="classpath:application.properties"/>

    <bean id="taskRepository" class="org.example.repository.TaskRepositoryJSON">
        <property name="filePath" value="${task.file.path}"/>
    </bean>

    <bean id="taskService" class="org.example.service.TaskService">
        <constructor-arg ref="taskRepository"/>
    </bean>

    <bean id="taskController" class="org.example.controller.TaskController" init-method="initScanner">
        <constructor-arg ref="taskService"/>
    </bean>

</beans>
